{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MikkoParkkola/trvl",
  "title": "trvl",
  "description": "Travel MCP server + CLI for flights, hotels, trains, cars & ferries. No API keys, single Go binary.",
  "version": "1.10.0",
  "repository": {
    "url": "https://github.com/MikkoParkkola/trvl",
    "source": "github"
  },
  "websiteUrl": "https://github.com/MikkoParkkola/trvl",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/mikkoparkkola/trvl:1.10.0",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "npm",
      "identifier": "trvl-mcp",
      "registryBaseUrl": "https://registry.npmjs.org",
      "version": "1.10.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}

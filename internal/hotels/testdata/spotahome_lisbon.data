nd floor, 2-bedroom apartment on Rua da Bica de Duarte Belo, Lisbon. Enjoy a striking dark grey colour scheme, stylish decor and A/C for your comfort.\n\nWe think this apartment is ideal for professionals. You're well connected to the city centre, and you'll never run out of restaurants to try.","/lisbon/for-rent:apartments/295826",{"_1079":284,"_1031":284,"_817":284,"_1032":284,"_818":284,"_1080":284,"_819":284,"_820":284,"_1288":284,"_822":284,"_823":284,"_1083":284,"_824":284,"_770":284,"_825":284,"_865":284,"_928":284,"_1084":284,"_1088":284,"_1089":284,"_1601":284,"_866":284,"_867":284,"_868":284,"_869":284,"_2603":284,"_2270":284,"_1767":284,"_870":284,"_772":284},[2723,2724],{"_757":2718,"_759":2719,"_9":761,"_369":2720},"c02026e0-bc8f-48cd-8f9f-9faff5b8d384",[2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717],[],["N",{"_729":2500,"_730":2702,"_211":731}],26,"71980aac00631eebdffbb65b6aa44cd8082e87e06c09e4ee18b86e8d","92ba306ae981da461f38a16251de6c7e7991ee8ab9b946a924380222","577f871d4b7a0bb4c8b5cadfcd227b27193d8b2c425973a9161507f1","12b12e029635393ecc8dce4cba81792c7cba931e9b7509ff67b3b5aa","dcc991ac00ebfe94df47d0e4356093e352b5b00f1c0782c84c196a42","0815f425e9d99d9f9729f1c7e9c0d5a5cd5378e6d3dc5503f5ceea9a","26701fb2bfe272da9563855f197ac3437cf455ed7cb3a75aab0eab7c","98341077fcf704f5250a542c43565114251123ab1acfd985405764ef","f3f1190adb58226d09036a9cfea6fb9db41cf99fcdcb1eb5926389e4","4b874049afdcc41ebcd0805bd2608c233b4545979400424ba69bf2d2","fb0e23b1b947d2111b15dac0e3520ce9c260dde9518b4ffc777d0895","cc2f19c767b7fb8d415ce40d6dc1ca5c700f42392a2a07c89517666b","fd043a8fd03aa5a9662b117a5d36d015e86340024ca4908d3d896be0","8a6dc55f18c39e1e5e9a6bd35b7ae5fdf22f3dd1212f72565981275a","c30cb98ea892db450fdf464313b7d66a84512ba827815fc680bb4cd0","R. da Bica de Duarte Belo, 1200-056 Lisboa, Portugal","1200-056",[2721,2722],-9.14594,38.70902,["N",{"_766":209,"_767":816,"_211":769}],["N",{"_766":209,"_767":1078,"_211":769}],"https://photos.spotahome.com/smw
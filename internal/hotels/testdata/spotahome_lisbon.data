viceViewType","browser","isSafari","initialCookie","","preloadedHomecards",[260,261,262],"tenantType",0,"sortingAlgorithm","DataScience-model5B-exploration","mapProviderVariant","woosmap","statistics",["N",{"_195":196,"_197":198,"_199":200,"_201":202}],"error","title","Apartments for Rent in Lisbon - Hire modern & furnished flats | Spotahome","metas",[120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148],"headerLinks",[105,106,107,108],"organizationJsonLd",{"_81":82,"_83":84,"_85":86,"_87":88,"_89":90},"headerScripts",[62,63,64,65,66,67,68,69],{"_72":80},{"_72":79},{"_70":71,"_72":78},{"_70":71,"_72":77},{"_70":71,"_72":76},{"_70":71,"_72":75},{"_70":71,"_72":74},{"_70":71,"_72":73},"type","application/ld+json","innerHTML","{\"@context\":\"https://schema.org\",\"@type\":\"Dataset\",\"name\":\"Most Popular Property Type rented in Lisbon\",\"description\":\"ROOMS are the top choice for people moving to Lisbon, Portugal.\",\"license\":\"https://www.spotahome.com/terms-and-conditions\",\"measurementTechnique\":\"Aggregated rental listing data from Spotahome platform\",\"creator\":{\"@type\":\"Organization\",\"name\":\"Spotahome\"},\"mainEntity\":{\"@type\":\"Table\",\"text\":\"Property type | Percentage\\nROOMS | 55.92%\\nAPARTMENTS | 28.78%\\nSTUDIOS | 12.37%\\nSTUDENT RESIDENCES | 2.92%\"}}","{\"@context\":\"https://schema.org\",\"@type\":\"Dataset\",\"name\":\"Our Tenant Profile in Lisbon\",\"description\":\"Most of our tenants in Lisbon, Portugal are 25-40 years old\",\"license\":\"https://www.spotahome.com/terms-and-conditions\",\"measurementTechnique\":\"Aggregated rental listing data from Spotahome platform\",\"creator\":{\"@type\":\"Organization\",\"name\":\"Spotahome\"},\"mainEntity\":{\"@type\":\"Table\",\"text\":\"Nationality | Percentage\\nPortugal | 10.63%\\nFrance | 10.04%\\nGermany | 9.39%\\nItaly | 8.75%\"}}","{\"@context\":\"https://schema.org\",\"@type\":\"SearchResultsPage\",\"about\":[{\"